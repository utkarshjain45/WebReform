# ==============================================================================
# WebReform Environment Variables Template
# Copy this file to .env and configure values before starting containers.
# DO NOT commit .env containing production secrets to version control.
# ==============================================================================

# --- Application Environment ---
ENVIRONMENT=development
COMPOSE_PROJECT_NAME=webreform

# --- PostgreSQL Database ---
POSTGRES_DB=webreform_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=replace_with_a_secure_password_in_production
POSTGRES_PORT=5432

# --- Spring Boot Backend ---
BACKEND_PORT=8080
SPRING_PROFILES_ACTIVE=docker
JWT_SECRET=replace_with_a_64_char_hmac_secret_key_when_auth_is_active

# --- WebReform Optimizer Engine ---
OPTIMIZER_PORT=8000
OPTIMIZER_WORKERS=2
LOG_LEVEL=info

# --- Client Application ---
FRONTEND_PORT=3000
VITE_API_URL=/api
